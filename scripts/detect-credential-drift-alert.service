[Unit]
Description=Push a notification when the credential-drift detector finds something
Documentation=file:/volume1/docker/arr-stack/scripts/detect-credential-drift.sh

[Service]
Type=oneshot
# Reuses the same ntfy.sh topic Diun already notifies on (DIUN_NTFY_TOPIC in
# .env) rather than provisioning a second channel - one topic, subscribed
# once, for every automated alert this stack sends.
EnvironmentFile=-/volume1/docker/arr-stack/.env
ExecStart=/bin/sh -c '\
  BODY=$(journalctl --user -u detect-credential-drift.service -n 20 --no-pager -o cat); \
  curl -sf -H "Title: arr-stack credential drift detected" -H "Priority: high" -H "Tags: warning" \
    -d "$BODY" \
    "https://ntfy.sh/${DIUN_NTFY_TOPIC}" \
'
