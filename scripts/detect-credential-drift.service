[Unit]
Description=Detect stale cross-app API keys in the arr-stack (Seerr/Bazarr/Sonarr/Radarr/Prowlarr)
Documentation=file:/volume1/docker/arr-stack/scripts/detect-credential-drift.sh

# OnFailure fires the alert unit below only when the detector exits non-zero
# (a real finding, or the check itself erroring) - not on every clean run.
# Same pattern as boot-compose-up.service alongside it: oneshot, no retry
# loop of its own, systemd's own failure handling does the fan-out.
OnFailure=detect-credential-drift-alert.service

[Service]
Type=oneshot
# Supplies RADARR_API_KEY/SONARR_API_KEY/PROWLARR_API_KEY - the detector's
# only stored credentials, already in .env for docker-compose's own
# declarative self-key wiring. Bazarr/Seerr's own keys aren't here - the
# script reads those fresh from each container's own config every run.
EnvironmentFile=/volume1/docker/arr-stack/.env
ExecStart=/bin/bash /volume1/docker/arr-stack/scripts/detect-credential-drift.sh
