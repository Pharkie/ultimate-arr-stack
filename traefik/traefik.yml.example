# Traefik Static Configuration
# https://doc.traefik.io/traefik/
#
# No edits required - just copy to traefik.yml
#
# NOTE: traefik.yml is gitignored (NAS-only, not synced by git pull), so an
# existing deployment's real traefik.yml won't pick up changes made here
# automatically - if you change this file, manually apply the same change
# to the live traefik.yml on the NAS (e.g. via docker exec / a text editor
# over SSH) and recreate the traefik container.

global:
  checkNewVersion: true
  sendAnonymousUsage: false

# API and Dashboard
api:
  dashboard: true
  insecure: false

# Entry Points
entryPoints:
  web:
    address: ":80"
    # HTTP only - Cloudflare Tunnel handles SSL for external access.
    # Local-only admin UIs (Sonarr, Radarr, etc. - see local-services.yml)
    # redirect :80 -> :443 via the https-redirect middleware; the
    # media-serving tier (Jellyfin/Seerr) stays plain HTTP on .lan, same as
    # before - Cloudflare already terminates TLS for their public access.
  websecure:
    address: ":443"
    # Internal-CA TLS for the local admin-UI tier only (see tls.yml's
    # `tls.certificates` block and local-services.yml's `-secure` routers).
    # Not used by Cloudflare Tunnel, which still targets `web`.

# Providers
providers:
  docker:
    # Routed through docker-socket-proxy (docker-compose.utilities.yml)
    # rather than a direct socket mount - see that service's comment for why
    # a `:ro` socket mount alone doesn't limit API access.
    endpoint: "tcp://docker-socket-proxy:2375"
    exposedByDefault: false
    network: arr-core
    watch: true

  file:
    directory: /dynamic
    watch: true

# Logging
log:
  level: INFO
  filePath: /var/log/traefik/traefik.log
  format: common

# Access Logs
accessLog:
  filePath: /var/log/traefik/access.log
  format: common
  bufferingSize: 100

# Ping for healthcheck
ping:
  entryPoint: web
