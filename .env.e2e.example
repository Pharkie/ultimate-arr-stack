# NAS hostname or IP
NAS_HOST=your-nas-hostname-or-ip

# Traefik's macvlan LAN IP (TRAEFIK_LAN_IP in .env) — used by DNS/routing tests
TRAEFIK_LAN_IP=your-traefik-lan-ip

# Magnetio's Redis password (MAGNETIO_REDIS_PASSWORD in .env) — used by addon tests
MAGNETIO_REDIS_PASSWORD=your_magnetio_redis_password

# API keys (Settings → General in each app)
RADARR_API_KEY=your_radarr_api_key
SONARR_API_KEY=your_sonarr_api_key
PROWLARR_API_KEY=your_prowlarr_api_key
SABNZBD_API_KEY=your_sabnzbd_api_key
BAZARR_API_KEY=your_bazarr_api_key

# Login credentials
JELLYFIN_USERNAME=your_jellyfin_username
JELLYFIN_PASSWORD=your_jellyfin_password
QBIT_USERNAME=admin
QBIT_PASSWORD=your_qbit_password
PIHOLE_PASSWORD=your_pihole_password
SONARR_USERNAME=your_sonarr_username
SONARR_PASSWORD=your_sonarr_password
RADARR_USERNAME=your_radarr_username
RADARR_PASSWORD=your_radarr_password
PROWLARR_USERNAME=your_prowlarr_username
PROWLARR_PASSWORD=your_prowlarr_password

# Suite knobs. Both are read by the tests themselves, not by the stack:
#
# ALLOW_DISRUPTIVE_TESTS=1 opts in to the one test that stops a live container
# (vpn-security.spec.ts's killswitch chaos test: it stops Gluetun, asserts
# qBittorrent's egress fails closed instead of leaking, then starts Gluetun and
# waits for healthy). Unset or 0, that test skips. It interrupts real downloads
# and searches for the duration, so it is never part of a routine run:
#   ALLOW_DISRUPTIVE_TESTS=1 npx playwright test tests/e2e/vpn-security.spec.ts -g killswitch
#
# E2E_EXECUTED_FLOOR raises the minimum number of tests a full-suite run must
# actually execute, enforced by executed-floor-reporter.ts. The default is 30 of
# the 58 collected; the reporter only applies it when a run collected 50 or
# more, so single-spec and -g runs are exempt by design. Lowering it is how you
# silence the guard; raising it is how you watch it fire:
#   E2E_EXECUTED_FLOOR=200 npx playwright test
#
ALLOW_DISRUPTIVE_TESTS=0
E2E_EXECUTED_FLOOR=30
